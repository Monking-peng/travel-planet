<view class="screen {{panel === 'scenery' ? 'scenery-editing' : ''}} {{sceneryInspectId ? 'scenery-inspecting' : ''}}">
  <view class="nav" style="padding-top:{{top}}px;height:{{top + 44}}px"><button class="nav-back" bindtap="back">← 工具箱</button><view class="nav-right"><button class="sound {{music ? 'on' : ''}}" bindtap="sound" aria-label="切换配乐">♫</button></view></view>
  <view class="screen-main">
    <view class="heading"><view class="eyebrow">{{stage}}</view><view class="title">{{title}}</view><view class="subtitle">{{subtitle}}</view></view>
    <view class="planet-wrap" style="{{sceneryInspectId ? 'height:calc(100vh - ' + (top + 245) + 'px)' : ''}}"><travel-planet wx:if="{{!planetFailed}}" id="travel-planet" class="planet" paused="{{panel ? panel !== 'scenery' : false}}" editing="{{panel === 'scenery'}}" bind:viewchange="planetViewChanged" selected="{{scenerySelected}}" bind:loaded="planetLoaded" bind:error="planetError" /><view wx:else class="planet-placeholder">杭州<view>湖边慢慢走</view></view><view wx:if="{{!planetFailed}}" class="planet-touch" catchtouchstart="planetTouchStart" catchtouchmove="planetTouchMove" catchtouchend="planetTouchEnd" catchtouchcancel="planetTouchCancel"/><view wx:if="{{room}}" class="member-orbit"><button wx:for="{{orbitMembers}}" wx:key="id" class="orbit-node orbit-{{item.position}}" data-member-id="{{item.id}}" bindtap="opinionsPanel"><view class="orbit-avatar" style="background:{{item.color}}">{{item.letter}}</view><view class="orbit-copy"><view>{{item.nickname}}</view><view>{{item.idea}}</view></view></button><button wx:if="{{members.length > 4}}" class="orbit-node orbit-3 orbit-more" bindtap="opinionsPanel">还有 {{members.length - 3}} 位旅伴 →</button></view></view>
    <view wx:if="{{!planetFailed}}" class="planet-controls"><button class="view-button" disabled="{{!sceneryReady}}" bindtap="planetToggle" aria-label="{{planetAuto ? '暂停自转' : '开始自转'}}">{{planetAuto ? 'Ⅱ' : '▷'}}</button><button class="decorate-planet" disabled="{{!sceneryReady}}" bindtap="sceneryPanel">{{sceneryReady ? "◇ 装扮星球" : "准备中…"}}</button><view class="zoom-controls"><button disabled="{{!sceneryReady || !planetCanZoomOut}}" bindtap="planetZoomOut" aria-label="缩小星球">−</button><text>{{planetZoom}}%</text><button disabled="{{!sceneryReady || !planetCanZoomIn}}" bindtap="planetZoomIn" aria-label="放大星球">＋</button></view><button class="view-button" disabled="{{!sceneryReady}}" bindtap="planetReset" aria-label="恢复星球视角">↺</button></view>
    <view wx:if="{{!planetFailed}}" class="planet-hint">单指旋转 · 双指缩放</view>
    <view wx:if="{{room}}" class="member-strip"><button class="orbit-caption" bindtap="opinionsPanel">{{members.length}} 位旅伴 · 点头像看看想法</button><button wx:if="{{isHost && !room.final && !room.closed && members.length < 6}}" class="member-add" bindtap="invitePanel">＋</button></view>
    <view wx:else class="tagline">2—6 位旅伴 · 1—3 天的小旅行</view>
    <view class="action-area"><button class="primary" disabled="{{connecting}}" bindtap="action">{{connecting ? "正在连接…" : serviceError ? "重新连接" : actionLabel}}</button><view wx:if="{{room || serviceError}}" class="tiny space">{{serviceError || note}}</view><view class="links"><button wx:if="{{room && !room.final && !room.closed && action !== 'ideas'}}" class="quiet" bindtap="ideasPanel">我的想法</button><button wx:if="{{room && action !== 'opinions'}}" class="quiet" bindtap="opinionsPanel">大家的想法</button><button wx:if="{{!room && serviceReady}}" class="quiet" bindtap="myTrips">我的旅行</button><button wx:if="{{room}}" class="quiet" bindtap="settings">更多</button></view></view>
  </view>
  <view class="footer">{{syncError || "每一个想法，都有被听见的地方"}}</view>
</view>
<block wx:if="{{panel}}">
  <view wx:if="{{panel !== 'scenery'}}" class="sheet-mask" bindtap="closePanel" catchtouchmove="noop" />
  <view class="sheet {{panel === 'scenery' ? 'scenery-sheet' : ''}} {{sceneryInspectId ? 'inspection-sheet' : ''}}"><view class="sheet-head"><text>{{panelTitle}}</text><button class="sheet-close" bindtap="closePanel" aria-label="关闭">×</button></view>
  <scroll-view scroll-y class="sheet-body" scroll-top="{{sceneryScrollTop}}" bindscroll="sceneryScrolled">

    <block wx:if="{{panel === 'scenery'}}">
      <view wx:if="{{sceneryInspectId}}" class="scenery-inspection"><button class="inspection-return" bindtap="sceneryReturn">← 全部景物</button><view class="inspection-navigation"><button data-step="-1" bindtap="sceneryBrowse" disabled="{{scenerySelected.length === 1}}" aria-label="上一个景物">‹</button><text>{{sceneryInspectPosition}}</text><button data-step="1" bindtap="sceneryBrowse" disabled="{{scenerySelected.length === 1}}" aria-label="下一个景物">›</button></view></view>
      <block wx:else>
      <scroll-view scroll-x><view class="scenery-presets"><button wx:for="{{sceneryPresets}}" wx:key="id" class="{{item.selected ? 'selected' : ''}}" data-preset="{{item.id}}" bindtap="sceneryPick">{{item.name}}</button></view></scroll-view>
      <view class="scenery-status">点图片靠近看 · 右上角添加或移除</view><view class="scenery-bar"><view class="scenery-filters"><button wx:for="{{sceneryCategories}}" wx:key="*this" data-category="{{item}}" bindtap="sceneryFilter" class="{{sceneryFilter === item ? 'selected' : ''}}">{{item}}</button></view><text>已放 {{scenerySelected.length}} 件</text></view>
      <view class="scenery-grid"><view wx:for="{{sceneryItems}}" wx:key="id" class="scenery-piece {{item.selected ? 'selected' : ''}}"><button class="piece-inspect" data-id="{{item.id}}" bindtap="sceneryInspect" aria-label="近看{{item.name}}"><image src="/scenery/assets/{{item.id}}.png" mode="aspectFit"/><text>{{item.name}}</text></button><button class="piece-mark" data-id="{{item.id}}" bindtap="sceneryPick" aria-label="{{item.name}} {{item.selected ? '移除' : '添加'}}">{{item.selected ? '✓' : '＋'}}</button></view></view>
      <view class="tiny space">外观保存在这台设备，装饰不加入行程。</view>
      </block>
    </block>
    <block wx:elif="{{panel === 'create'}}">
      <view class="field"><text class="field-title">怎么称呼你</text><input value="{{create.nickname}}" maxlength="16" placeholder="旅伴能认出的名字" data-scope="create" data-key="nickname" bindinput="field" /></view>
      <view class="field"><text class="field-title">给旅行起个名字</text><input value="{{create.title}}" maxlength="32" data-scope="create" data-key="title" bindinput="field" /></view>
      <view class="row"><view class="field"><text class="field-title">出发日期</text><picker mode="date" value="{{create.startDate}}" bindchange="createDate"><view class="picker">{{create.startDate}}</view></picker></view><view class="field"><text class="field-title">玩几天</text><picker range="{{dayOptions}}" value="{{create.days - 1}}" bindchange="createDays"><view class="picker">{{create.days}} 天</view></picker></view></view>

      <view class="tiny">创建后，把邀请发给朋友。全员明确接受同一份方案，才会定稿。</view><view class="sheet-actions"><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submitCreate">创建旅行</button></view>
    </block>
    <block wx:elif="{{panel === 'join'}}"><view class="title">{{invite.title}}</view><view class="muted">{{invite.dateLabel}} · {{invite.days}} 天</view><view class="field"><text class="field-title">怎么称呼你</text><input value="{{create.nickname}}" maxlength="16" placeholder="旅伴能认出的名字" data-scope="create" data-key="nickname" bindinput="field" /></view><view class="tiny">加入后，你的想法会向这次旅行的成员展示。</view><view class="sheet-actions"><button class="primary" loading="{{busy}}" disabled="{{busy || invite.final}}" bindtap="submitJoin">{{invite.final ? '旅行已经定稿' : '加入这趟旅行'}}</button></view></block>
    <block wx:elif="{{panel === 'invite'}}"><view class="muted">把邀请发到微信群，朋友填写昵称后就能加入，一起决定怎么玩。</view><view class="space"><button class="primary" open-type="share">发给微信好友</button><button class="quiet" bindtap="copyInvite">复制网页邀请</button></view><view class="tiny">持有邀请的人可以加入，最多 6 人。发起人可以在更多选项中撤销旧邀请。</view></block>
    <block wx:elif="{{panel === 'ideas'}}">
      <view class="field"><text class="field-title">随便说说你的想法</text><textarea value="{{draft.text}}" maxlength="1000" placeholder="比如：想看看西湖，吃点好吃的，别安排太早。" data-scope="draft" data-key="text" bindinput="field" /><view class="tiny">原话会分享给旅伴，个人预算请填在专用字段。</view></view>
      <button wx:if="{{ai}}" class="small-button" loading="{{busy}}" disabled="{{busy}}" bindtap="extract">帮我整理一下</button>
      <view wx:if="{{extractionNotice}}" class="tiny space">{{extractionNotice}}</view>
      <view wx:if="{{submissionNotice}}" class="tiny space" aria-role="status">{{submissionNotice}}</view>
      <view wx:if="{{extraction}}" class="info">{{extraction.summary}}<view wx:for="{{extraction.questions}}" wx:key="*this">待补充：{{item}}</view><view>检查整理结果，确认后再提交。</view></view>
      <view class="field"><text class="field-title">喜欢的旅行感觉</text><view class="chips"><button wx:for="{{tags}}" wx:key="name" class="chip {{item.selected ? 'selected' : ''}}" data-group="tags" data-id="{{item.name}}" bindtap="toggleChip">{{item.name}}</button></view></view>
      <view class="field"><text class="field-title">想去的地方 · 可多选</text><view class="tiny">第一版只安排下方 10 个去处，目录外地点暂不纳入方案。</view><view class="chips"><button wx:for="{{places}}" wx:key="id" class="chip {{item.wanted ? 'selected' : ''}}" data-group="wants" data-id="{{item.id}}" bindtap="toggleChip">{{item.name}}</button></view></view>
      <view class="row"><view class="field"><text class="field-title">当地活动预算 / 人</text><input type="number" value="{{draft.budget}}" data-scope="draft" data-key="budget" bindinput="field" /><view class="tiny">这 {{room.days}} 天合计，含餐饮与市内交通，不含住宿和往返杭州。个人金额仅自己可见。</view></view><view class="field"><text class="field-title">每天最多走多远</text><picker range="{{walkOptions}}" value="{{walkIndex}}" data-key="maxWalk" bindchange="prefPicker"><view class="picker">{{walkOptions[walkIndex]}}</view></picker></view></view>
      <view class="row"><view class="field"><text class="field-title">最早几点出门</text><picker range="{{hourOptions}}" value="{{hourIndex}}" data-key="startHour" bindchange="prefPicker"><view class="picker">{{hourOptions[hourIndex]}}</view></picker></view><view class="field"><text class="field-title">想要的节奏</text><picker range="{{paceOptions}}" value="{{paceIndex}}" data-key="pace" bindchange="prefPicker"><view class="picker">{{paceOptions[paceIndex]}}</view></picker></view></view>
      <button class="quiet" bindtap="toggleAdvanced">{{advanced ? '收起其他限制' : '还有必须满足的事'}}</button>
      <block wx:if="{{advanced}}"><view class="field"><text class="field-title">一定要去</text><view class="chips"><button wx:for="{{places}}" wx:key="id" class="chip {{item.must ? 'selected' : ''}}" data-group="must" data-id="{{item.id}}" bindtap="toggleChip">{{item.name}}</button></view></view><view class="field"><text class="field-title">这次不去</text><view class="chips"><button wx:for="{{places}}" wx:key="id" class="chip {{item.avoid ? 'selected' : ''}}" data-group="avoid" data-id="{{item.id}}" bindtap="toggleChip">{{item.name}}</button></view></view><view class="field"><text class="field-title">饮食或其他限制</text><input value="{{draft.diet}}" maxlength="120" placeholder="比如不吃辣，想留出午休时间" data-scope="draft" data-key="diet" bindinput="field" /></view></block>
      <view class="sheet-actions"><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submitPrefs">确认，把想法放上去</button></view><view class="tiny">随时可以回来改。修改后大家需要重新确认最新方案。</view>
    </block>
    <block wx:elif="{{panel === 'opinions'}}">
      <view wx:for="{{conflicts}}" wx:key="placeId" class="info"><view>{{item.title}}</view><view>{{item.detail}}</view><button wx:if="{{item.mine && !room.closed && !room.final}}" class="quiet" bindtap="adjustLimits">调整我的限制</button></view>
      <view wx:for="{{opinionMembers}}" wx:key="id" class="opinion"><view class="person"><view class="avatar" style="background:{{item.color}}">{{item.letter}}</view><view><view>{{item.nickname}}{{item.id === room.me ? ' · 我' : ''}}</view><view class="tiny">{{item.preferences ? '已写下想法' : '还没写想法'}}</view></view></view><block wx:if="{{item.preferences}}"><view class="opinion-text">{{item.preferences.text || '先选了一些旅行偏好。'}}</view><view class="tiny">{{item.preferences.startHour}}:00 后出门 · 每天最多 {{item.preferences.maxWalk}} 公里</view><view wx:if="{{item.wantNames}}" class="muted">想去：{{item.wantNames}}</view><view wx:if="{{item.mustNames}}" class="tiny">必去：{{item.mustNames}}</view><view wx:if="{{item.avoidNames}}" class="tiny">不去：{{item.avoidNames}}</view><view wx:if="{{item.preferences.diet}}" class="tiny">其他限制：{{item.preferences.diet}}</view></block></view>
      <button wx:if="{{memberOnly}}" class="quiet" bindtap="opinionsPanel">看看所有人的想法</button><view class="field-title space">再补充一句</view><view wx:for="{{comments}}" wx:key="id" class="comment"><text class="tiny">{{item.nickname}}</text><view>{{item.text}}</view></view><block wx:if="{{!room.closed && !room.final}}"><textarea value="{{comment}}" maxlength="500" placeholder="针对这趟旅行补充一点想法…" data-key="comment" bindinput="field" /><button class="secondary space" loading="{{busy}}" disabled="{{busy}}" bindtap="addComment">补充想法</button></block>
    </block>
    <block wx:elif="{{panel === 'generate'}}"><view wx:if="{{generationNotice}}" class="info">{{generationNotice}}</view><view class="muted">{{room.summary.submitted}}/{{members.length}} 位旅伴已经写好想法。{{ai ? 'AI 会参考偏好和限制，给出两份有不同取舍的方案。' : '当前使用基础排程，按地点和限制安排，不是 AI 生成。'}}</view><view wx:for="{{conflicts}}" wx:key="placeId" class="info"><view>{{item.title}}</view><view>{{item.detail}}</view><button wx:if="{{item.mine && !room.closed && !room.final}}" class="quiet" bindtap="adjustLimits">调整我的限制</button></view><view class="field"><text class="field-title">这一轮，想重点考虑什么？</text><textarea value="{{feedback}}" maxlength="1000" placeholder="选填，比如保留西湖散步，第二天轻松一点。" data-key="feedback" bindinput="field" /></view><view class="tiny">新方案生成后，大家需要重新确认。没有回应不算同意。</view><view class="sheet-actions"><button class="primary" loading="{{busy}}" disabled="{{busy || !isHost || room.closed || room.final || room.summary.missing.length || room.summary.conflicts.length}}" bindtap="generate">{{ai ? '整理两份方案' : '生成基础方案'}}</button><button wx:if="{{ai}}" class="quiet" disabled="{{busy || !isHost || room.closed || room.final || room.summary.missing.length || room.summary.conflicts.length}}" data-mode="basic" bindtap="generate">先用基础排程</button></view></block>
    <block wx:elif="{{panel === 'plans'}}">
      <view class="tiny">“更喜欢”只记录偏好；选择“可以接受”才计入定稿。</view>
      <view wx:for="{{proposals}}" wx:key="id" class="plan-card"><view class="tiny">方案 {{item.index}} · 第 {{item.version}} 版{{item.mode === 'basic' ? ' · 基础排程' : ''}}</view><view class="plan-title">{{item.title}}</view><view class="muted">{{item.reason}}</view><view class="plan-metrics"><view>约 ¥{{item.budget}}<view class="tiny">每人当地活动费用</view></view><view>约 {{item.walk}} km<view class="tiny">{{room.days}} 天总步行</view></view></view><view class="tiny">{{item.placeNames}}</view><button class="quiet left" data-id="{{item.id}}" bindtap="detail">展开每天怎么走 →</button><view wx:if="{{item.omittedNames}}" class="tiny">暂未纳入：{{item.omittedNames}}</view><view wx:if="{{item.stale}}" class="info">意见已经变化，请重新整理方案。</view><view wx:if="{{!room.closed && !room.final}}" class="vote-options"><button class="{{item.myVote === 'prefer' ? 'selected' : ''}}" data-id="{{item.id}}" data-value="prefer" disabled="{{busy || item.stale}}" bindtap="vote">更喜欢这份</button><button class="{{item.myVote === 'accept' ? 'selected' : ''}}" data-id="{{item.id}}" data-value="accept" disabled="{{busy || item.stale}}" bindtap="vote">可以接受</button><button class="{{item.myVote === 'change' ? 'selected' : ''}}" data-id="{{item.id}}" data-value="change" disabled="{{busy || item.stale}}" bindtap="vote">需要修改</button></view><view class="plan-status"><text>{{item.accepted}}/{{members.length}} 人可以接受</text><button class="quiet" data-id="{{item.id}}" bindtap="responses">看反馈</button></view><block wx:if="{{isHost && !room.final && !room.closed}}"><button class="primary" disabled="{{busy || !item.canFinalize.ok}}" data-id="{{item.id}}" bindtap="finalize">就定这份</button><view wx:if="{{!item.canFinalize.ok}}" class="tiny space">{{item.canFinalize.reason}}</view></block></view>
      <button wx:if="{{isHost && !room.final && !room.closed}}" class="secondary" bindtap="generatePanel">根据大家反馈，调整方案</button>
    </block>
    <block wx:elif="{{panel === 'reason'}}"><view class="field"><text class="field-title">说具体一点，方便大家一起改</text><textarea value="{{reason}}" maxlength="300" placeholder="比如第二天下午想少走一点，或一定要保留坐船。" data-key="reason" bindinput="field" /></view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submitReason">告诉大家</button></block>
    <block wx:elif="{{panel === 'responses'}}"><view wx:if="{{responseStale}}" class="info">这份反馈属于旧方案，不能用于当前确认。请回到两份方案查看最新安排。</view><view wx:for="{{responses}}" wx:key="id" class="opinion"><view>{{item.nickname}}</view><view class="tiny">{{item.label}}</view><view wx:if="{{item.reason}}" class="muted">{{item.reason}}</view></view><button class="secondary space" bindtap="plansPanel">回到两份方案</button></block>
    <block wx:elif="{{panel === 'detail'}}">
      <view wx:if="{{planFinal && room.final.acceptanceVerified === false}}" class="info">历史确认待复核：部分反馈未明确接受，请发起人重新开启讨论。</view>
      <view wx:if="{{planHistory}}" class="info">这是之前保存的方案，旧确认不适用于当前行程。</view><view class="muted">{{selectedPlan.subtitle}}</view><map class="route-map" latitude="30.2500" longitude="120.1450" markers="{{mapMarkers}}" include-points="{{mapPoints}}" polyline="{{mapLines}}" show-location="{{false}}" /><view class="tiny">地点连线为顺序示意，不代表实际道路。</view>
      <view wx:for="{{selectedPlan.days}}" wx:for-item="day" wx:key="day"><view class="day-title">第 {{day.day}} 天<text>步行约 {{day.walk}} km</text></view><view wx:for="{{day.events}}" wx:for-item="stop" wx:key="startMinute" class="stop"><view class="stop-time">{{stop.time}}</view><view class="stop-copy"><button wx:if="{{stop.kind === 'place'}}" data-id="{{stop.placeId}}" bindtap="navigatePlace">{{stop.title}} ↗</button><view wx:else class="rest-title">{{stop.title}}</view><view class="tiny">约 {{stop.minutes}} 分钟</view><view wx:if="{{stop.transit}}" class="tiny">{{stop.transit.mode}}约 {{stop.transit.minutes}} 分钟</view></view></view><view class="tiny">{{day.endTime ? "约 " + day.endTime + " 结束安排，之后自由走走。" : "午间留出约 1 小时吃饭休息。"}}</view></view>
      <view class="divider"/><view class="tiny">{{selectedPlan.estimateNote}}</view><button wx:if="{{planFinal}}" class="primary space" bindtap="copyPlan">复制最终行程</button><button wx:elif="{{planHistory}}" class="secondary space" bindtap="history">回到旧方案</button><button wx:else class="secondary space" bindtap="plansPanel">回到方案比较</button>
    </block>
    <block wx:elif="{{panel === 'trips'}}"><view wx:if="{{!trips.length && !busy}}" class="muted center">还没有旅行。发起一趟，或者打开朋友的邀请。</view><button wx:for="{{trips}}" wx:key="id" class="trip-row" data-id="{{item.id}}" bindtap="openTrip"><view>{{item.title}}</view><view class="tiny">{{item.date}} · {{item.members}} 人</view></button><button class="primary space" bindtap="createPanel">发起新旅行</button></block>
    <block wx:elif="{{panel === 'settings'}}"><view class="muted">{{room.title}} · {{members.length}} 位旅伴</view><view wx:for="{{members}}" wx:key="id" class="person"><view class="avatar" style="background:{{item.color}}">{{item.letter}}</view><view>{{item.nickname}}</view><text wx:if="{{item.id === room.hostId}}" class="tiny">发起人</text><button wx:if="{{isHost && item.id !== room.me && !room.closed}}" class="small-button" data-action="transfer" data-id="{{item.id}}" bindtap="manage">转交管理</button></view><view class="divider"/><block wx:if="{{isHost && !room.closed}}"><button wx:if="{{room.final}}" class="secondary" data-action="reopen" bindtap="manage">开启新一轮讨论</button><button wx:else class="secondary" data-action="rotateInvite" bindtap="manage">撤销旧邀请，生成新邀请</button><button class="quiet danger space" data-action="close" bindtap="manage">关闭这次旅行</button></block><button wx:if="{{!isHost && !room.closed && !room.final}}" class="quiet danger" data-action="leave" bindtap="manage">退出这次旅行</button><button class="quiet" bindtap="history">之前的方案</button><button class="quiet" bindtap="about">关于与数据说明</button></block>
    <block wx:elif="{{panel === 'history'}}"><view wx:if="{{!historyEntries.length}}" class="muted">还没有旧版本，修改方案时会把之前的安排留在这里。</view><view wx:for="{{historyEntries}}" wx:key="index" class="opinion"><view>{{item.label}}</view><view class="tiny">{{item.savedAt}} 保存 · 旧版确认不适用于当前方案</view><button wx:for="{{item.plans}}" wx:for-item="plan" wx:key="id" class="trip-row" data-id="{{plan.id}}" bindtap="historyDetail">{{plan.title}} →<view class="tiny">第 {{plan.version}} 版 · 查看完整安排</view></button></view></block>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{busy}}" class="tiny center space">正在处理，已填内容会保留…</view>
  </scroll-view></view>
</block>
