# Optional local configuration; no key is needed for basic planning.
HOST=127.0.0.1
PORT=4178
TRAVEL_DB=.local/travel.sqlite
COOKIE_SECURE=false
COOKIE_PATH=/
TRUST_PROXY=false

# Optional OpenAI-compatible endpoint, including its /v1 path when required.
TRAVEL_AI_BASE_URL=
TRAVEL_AI_MODEL=
TRAVEL_AI_KEY=
TRAVEL_AI_DAILY_LIMIT=200

# Only needed when deploying the historical WeChat relay yourself.
TRAVEL_BRIDGE_KEY=
TRAVEL_API_BASE_URL=
